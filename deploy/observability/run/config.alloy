discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "run" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    regex         = "wadadak-run;run|wadadak-run-observability;smoke"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "run" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.run.output
  forward_to = [loki.process.run.receiver]
}

loki.process "run" {
  forward_to = [loki.write.ops_pc.receiver]

  stage.drop {
    older_than = "168h"
  }

  // Each branch writes only an allowlisted summary to safe_line (core/config.alloy와 같은 방식).
  // 작업 실패 줄은 ERROR지만 "Spring ERROR"가 아니라 그 줄 그대로 보낸다(알림 "run 작업 실패").
  stage.match {
    selector = `{service="run"}`

    stage.regex {
      expression = `(?P<startup>Started RunServiceApplication in [0-9.]+ seconds)|(?P<failure>(?:Free run processing|GPS gap check|Run event publication) failed for [0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})`
    }

    stage.regex {
      expression = `^\d{4}-\d{2}-\d{2}[T ]\S+\s+(?P<run_level>WARN|ERROR)\s+\d+\s+---\s+(?:\[[^\]]*\]\s+)+(?P<run_logger>[A-Za-z0-9_.$]+)\s*:`
    }

    stage.template {
      source   = "safe_line"
      template = `{{ $level := toString (default "" .run_level) }}{{ $logger := toString (default "" .run_logger) }}{{ if .startup }}{{ .startup }}{{ else if .failure }}{{ .failure }}{{ else if eq $level "ERROR" }}Spring ERROR {{ $logger }}{{ else if and (eq $level "WARN") (or (hasPrefix "com.wadadak." $logger) (hasPrefix "c.w." $logger)) }}Spring WARN {{ $logger }}{{ end }}`
    }
  }

  stage.match {
    selector = `{service="smoke"}`

    stage.regex {
      expression = `^(?P<safe_line>WADADAK_OBSERVABILITY_SMOKE [0-9]{8}T[0-9]{6}Z)\s*$`
    }
  }

  stage.labels {
    values = { allowed = "safe_line" }
  }

  stage.match {
    selector            = `{allowed=""}`
    action              = "drop"
    drop_counter_reason = "outside_run_log_allowlist"
  }

  stage.label_drop {
    values = ["allowed"]
  }

  stage.output {
    source = "safe_line"
  }
}

loki.write "ops_pc" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
}
