				<!-- 카카오 로그인 후 앱으로 돌아오는 스킴. kakao{네이티브 앱 키}(lib/core/config.dart와 같게) -->
				<string>kakao57b43e47368fd814ab5a8ae64dd726d3</string>
			</array>
		</dict>
	</array>
